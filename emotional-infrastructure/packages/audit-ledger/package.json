{
  "name": "@emotional-infrastructure/audit-ledger",
  "version": "0.1.0",
  "description": "Canonicalization, hashing, and Dignity Ledger hash-chain verification primitives shared by the SDK and web dashboard.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.0.1",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "license": "Apache-2.0"
}
