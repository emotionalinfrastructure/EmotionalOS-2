# Emotional Infrastructure Governance Runtime -- example environment file.
# Copy to .env and adjust for local development. Values here are safe
# defaults for local/dev use only -- they are NOT production secrets.

# --- Backend (apps/api) ---
EI_ENVIRONMENT=development
EI_DATABASE_URL=postgresql+psycopg://ei:ei@localhost:5432/emotional_infrastructure
EI_JWT_ISSUER=https://ei-governance-runtime.local
EI_JWT_AUDIENCE=ei-governance-runtime
EI_JWT_ALGORITHM=ES256
EI_TOKEN_TTL_SECONDS=300
EI_LEDGER_HMAC_SECRET=change-me-in-production
EI_POLICY_URI_DEFAULT=https://ei-governance-runtime.local/policy/v1
EI_CONSENT_VERSION=ctp-0.1
EI_CORS_ORIGINS=http://localhost:3000

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
